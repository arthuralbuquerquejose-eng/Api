<!DOCTYPE html>
<html lang="en">

    <head>
        <meta charset="UTF-8">
        <title>Meu editar</title>
    </head>

    <body>
        <h2>Editar Registro</h2>
        <% crud.forEach(function(details) { %>
            <form action="/edit/<%= details._id %>" method="POST">
               <input type="text" value="<%= details.name %>" name="nome">
                <input type="text" value="<%= details.cpf %>" name="cpf">
                 <input type="text" value="<%= details.email %>" name="email">
                  <input type="text" value="<%= details.telefone %>" name="telefone">
                <br/>
                <button>
                    <a href="/show">Todos</a>
                </button>
                <button type="submit">Editar</button>
            </form>
        <% }) %>
    </body>

</html>